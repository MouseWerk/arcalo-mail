<?xml version="1.0" encoding="utf-8"?>
<!-- The debug build: as the release build (src/main/res/xml), and plain HTTP for the development
     server of `cargo tauri android dev`. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
