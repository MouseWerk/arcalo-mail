<?xml version="1.0" encoding="utf-8"?>
<!-- No plain HTTP (the debug build allows it for the development server, src/debug/res/xml). The
     app's own connections check certificates in Rust (mail_core::network). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
