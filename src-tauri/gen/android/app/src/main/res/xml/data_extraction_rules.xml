<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone in a backup or a device transfer (Android 12 and later): the mail is a
     copy of the server's, and the sealed secrets cannot be read without this phone's Keystore key. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
